@page "/Kitchen"
@using nabegemu.Components.Components
@inject NavigationManager Navigation
@inject ProtectedSessionStorage SessionStorage
@implements IAsyncDisposable

<div class="flex align-items-center content-center">
    <h3>Kitchen</h3>
</div>

<div class="flex items-end flex-direction--column">
    <div class="flex items-center mb-2">
        <div class="min-w-[150px] relative">
            <div class="flex items-center peer w-full p-2 bg-inherit border-2 rounded-md outline-none transition border-black text-black"
            type="text"
            id="gameCode">
                <span>Game code: @gameCode</span>
            </div>
        </div>
    </div>

    <div class="flex items-center mb-2">
        <div class="min-w-[150px] relative">
            <div class="flex items-center peer w-full p-2 bg-inherit border-2 rounded-md outline-none transition border-black text-black"
            type="text"
            id="playerName">
                <svg class="mr-2"
                fill=""
                width="18"
                height="18"
                viewBox="0 0 344 384">
                    <path d="M170.5 192q-35.5 0-60.5-25t-25-60.5T110 46t60.5-25T231 46t25 60.5t-25 60.5t-60.5 25zm0 43q31.5 0 69.5 9t69.5 29.5T341 320v43H0v-43q0-26 31.5-46.5T101 244t69.5-9z"
                    fill="gray"></path>
                </svg>
                <span>@playerName</span>
            </div>
        </div>
    </div>
</div>

@if (dataLoaded)
{
    if (!isActivePlayer)
    {
        <div class="flex flex-col items-center relative z-50">
            <div class="w-full gap-x-2 flex justify-center items-center mb-2">
                <div class="w-5 bg-[#d991c2] animate-pulse h-5 rounded-full animate-bounce"></div>
                <div class="w-5 animate-pulse h-5 bg-[#9869b8] rounded-full animate-bounce"></div>
                <div class="w-5 h-5 animate-pulse bg-[#6756cc] rounded-full animate-bounce"></div>
            </div>
            <p>Other chefs are cooking. Waiting for your turn...</p>
        </div>
        <div class="w-full h-full fixed top-0 left-0 bg-white opacity-75 z-10"></div>
    }
    <div class="flex flex-col px-2 md:px-20">
        <div data-selection-area>
            <div data-discard-area class="flex mb-2">

                <div data-discard-area-a class="p-1 mr-2 border-2 border-black rounded-lg flex flex-col items-center">
                    @if (kitchenThings.PlayerDiscardA.Any())
                    {
                        var lastCard = kitchenThings.PlayerDiscardA.Last();
                        <FaceCard CardData="@lastCard" IsDeckModificationModeActive="@isDeckModificationModeActive" DataAttribute="draw-deck" />
                    }
                    else
                    {
                        <BackCard DataAttribute="draw-deck" />
                    }
                    <p>Discard A</p>
                </div>

                <div data-discard-area-b class="p-1 mr-2 border-2 border-black rounded-lg flex flex-col items-center">
                    @if (kitchenThings.PlayerDiscardB.Any())
                    {
                        var lastCard = kitchenThings.PlayerDiscardB.Last();
                        <FaceCard CardData="@lastCard" IsDeckModificationModeActive="@isDeckModificationModeActive" DataAttribute="draw-deck" />
                    }
                    else
                    {
                        <BackCard DataAttribute="draw-deck" />
                    }
                    <p>Discard B</p>
                </div>

                <div data-discard-area-c class="p-1 mr-2 border-2 border-black rounded-lg flex flex-col items-center">
                    @if (kitchenThings.PlayerDiscardC.Any())
                    {
                        var lastCard = kitchenThings.PlayerDiscardC.Last();
                        <FaceCard CardData="@lastCard" IsDeckModificationModeActive="@isDeckModificationModeActive" DataAttribute="draw-deck" />
                    }
                    else
                    {
                        <BackCard DataAttribute="draw-deck" />
                    }
                    <p>Discard C</p>
                </div>

                <div data-discard-area-yours class="p-1 border-2 border-black rounded-lg flex flex-col items-center">
                    @if (kitchenThings.YourDiscard.Any())
                    {
                        var lastCard = kitchenThings.YourDiscard.Last();
                        <FaceCard CardData="@lastCard" IsDeckModificationModeActive="@isDeckModificationModeActive" DataAttribute="draw-deck" />
                    }
                    else
                    {
                        <BackCard DataAttribute="draw-deck" />
                    }
                    <p>Your Discard</p>
                </div>
            </div>

            @if (canDrawCard)
            {
                <div data-draw-area class="flex space-x-4 mb-2 justify-center">
                    <div data-draw-deck
                    class="border-2 border-black rounded-lg bg-orange-100 w-28 h-48 p-1.5 text-sm flex flex-col justify-center cursor-pointer"
                    @onclick="DrawCard">
                        <div class="flex justify-center">
                            <div>
                                <img src="/images/hot-pot-cute-logo-1.png"
                                class="h-15 w-auto"
                                alt="Game Logo"
                                aria-label="Back of card showing game logo" />
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (activeCard is not null && !cardSelectionComplete)
        {
            <div data-active-card-area class="flex space-x-4 mb-2 justify-center">
                <FaceCard CardData="@activeCard" IsDeckModificationModeActive="false" DataAttribute="active-card" />
            </div>
        }

        <div data-your-deck-area
        class="flex space-x-4 mb-2 justify-center border-2 border-gray-200 rounded-lg py-10 bg-slate-100">
            @foreach (var card in kitchenThings.YourHand)
            {
                <FaceCard CardData="@card"
                          IsDeckModificationModeActive="@isDeckModificationModeActive"
                          DataAttribute="your-deck-card"
                          OnClickCallback="EventCallback.Factory.Create<Card>(this, SwapWithActiveCard)" />
            }
        </div>
    </div>
}
else
{
    <div class="flex flex-col px-2 md:px-20 items-center">
        <button class="inline-block rounded-full border-2 border-rose-500 text-rose-500 hover:border-rose-600 hover:bg-rose-400 hover:bg-opacity-10 hover:text-rose-600 focus:border-rose-700 focus:text-rose-700 active:border-rose-800 active:text-rose-800 dark:border-rose-300 dark:text-rose-300 dark:hover:hover:bg-rose-300 px-6 pb-2 pt-2.5 text-xs font-medium uppercase leading-normal transition duration-150 ease-in-out focus:outline-none focus:ring-0"
        type="button">
            <div role="status"
            class="inline-block h-3 w-3 mr-2 animate-spin rounded-full border-2 border-solid border-current border-r-transparent align-[-0.125em] motion-reduce:animate-[spin_1.5s_linear_infinite]">
                <span class="!absolute !-m-px !h-px !w-px !overflow-hidden !whitespace-nowrap !border-0 !p-0 ![clip:rect(0,0,0,0)]">
                    Prepping kitchen...
                </span>
            </div>
            Prepping kitchen
        </button>
    </div>
}

@code {
    private HubConnection? hubConnection;
    private KitchenThings kitchenThings;
    private int gameCode;
    private Player sessionPlayer;
    private string playerId = string.Empty;
    private string playerName = string.Empty;
    private bool dataLoaded;
    private bool canDrawCard;
    private bool isDeckModificationModeActive;
    private Card activeCard;
    private bool isActivePlayer;
    private bool cardSelectionComplete;

    protected override async Task OnInitializedAsync()
    {
        hubConnection = new HubConnectionBuilder()
        .WithUrl(Navigation.ToAbsoluteUri("/lobbyhub"))
        .Build();

        hubConnection.On<Player>("PrepKitchenComplete", async (player) =>
        {
            dataLoaded = true;
            kitchenThings = player.KitchenThings;
            gameCode = player.Code;
            sessionPlayer = player;
            playerId = player.Id.ToString();
            playerName = player.Name;
            isActivePlayer = player.IsActivePlayer;

            if (player.IsActivePlayer) {
                canDrawCard = true;
            }

            await InvokeAsync(StateHasChanged);
        });

        hubConnection.On<bool>("SetActivePlayerInSession", async (isActivePlayer) =>
        {
            await SessionStorage.SetAsync("IsActivePlayer", isActivePlayer);
        });

        hubConnection.On<bool>("SetInactivePlayerInSession", async (isActivePlayer) =>
        {
            await SessionStorage.SetAsync("IsActivePlayer", isActivePlayer);
        });

        hubConnection.On<bool>("SwapWithActiveCardComplete", async (isSuccess) =>
        {

            cardSelectionComplete = true;
            ResetActivePlayerState();
            await PrepKitchen();

            await InvokeAsync(StateHasChanged);
        });

        await hubConnection.StartAsync();
    }

    private async Task PrepKitchen()
    {
        if (hubConnection is not null)
        {
            await hubConnection.SendAsync("PrepKitchen", gameCode, playerId);
        }
    }

    private async Task DrawCard()
    {
        activeCard = kitchenThings.DrawDeckCard;
        canDrawCard = false;
        isDeckModificationModeActive = true;
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var sessionPlayerId = await SessionStorage.GetAsync<Guid>("PlayerId");
            var sessionGameCode = await SessionStorage.GetAsync<int>("GameCode");
            gameCode = sessionGameCode.Value;
            playerId = sessionPlayerId.Value.ToString();

            await SetActivePlayer();
            await PrepKitchen();
        }
    }

    private async Task SetActivePlayer()
    {
        if (hubConnection is not null)
        {
            await hubConnection.SendAsync("SetActivePlayerInSession", gameCode);
        }
    }

    private async Task SwapWithActiveCard(Card cardToSwap)
    {
        if (isDeckModificationModeActive) {
            if (hubConnection is not null)
            {
                await hubConnection.SendAsync("SwapWithActiveCard", gameCode, playerId, cardToSwap, activeCard);
            }
        } else {
            await Task.CompletedTask;
            return;
        }        
    }

    private void ResetActivePlayerState() {
        isDeckModificationModeActive = false;
        canDrawCard = false;
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}